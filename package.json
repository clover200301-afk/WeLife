{
  "name": "welife",
  "version": "1.0.0",
  "description": "WeLife - Personal relationship and chat record management tool",
  "main": "dist-electron/main/index.js",
  "homepage": "./",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "postinstall": "npx @electron/rebuild -f -w better-sqlite3",
    "dist": "electron-vite build && npx electron-builder",
    "dist:mac": "electron-vite build && npx electron-builder --mac",
    "dist:mac:fast": "electron-vite build && npx electron-builder --mac dmg --arm64",
    "dist:win": "electron-vite build && npx electron-builder --win",
    "pack": "electron-vite build && npx electron-builder --dir"
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "d3-force": "^3.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.0.0",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  },
  "build": {
    "appId": "com.welife.app",
    "productName": "WeLife",
    "copyright": "Copyright © 2025 WeLife",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "icon": "build/icon.icns"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WeLife"
    }
  }
}
